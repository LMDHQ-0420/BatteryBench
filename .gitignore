# Data (repo-root only; do not match src/data/)
/data/

# Results — track metrics and CSV predictions; ignore local large artifacts
results/**/*.pt
results/**/*.pkl
results/**/*.npz

# Logs — track json summaries, ignore raw log files
*.log

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Env
.env
*.env
.venv/

# Temp files
*.tmp
*.temp
tmp/
temp/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Local backups and pipeline state
/backups/
/pipeline_state/
.pytest_cache/
